# ============================================================
# Lunelle Studio — environment configuration template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Runtime mode ---
# development | production | test
LUNELLE_ENV=production
# 1 enables debug responses with stack traces. MUST be 0 in production.
LUNELLE_DEBUG=0
# Log level: DEBUG | INFO | WARNING | ERROR
LUNELLE_LOG_LEVEL=INFO

# --- Server ---
# Bind address. Use 0.0.0.0 inside Docker, 127.0.0.1 for local-only.
LUNELLE_HOST=127.0.0.1
LUNELLE_PORT=8300
# Admin token: REQUIRED when LUNELLE_ENV=production (startup refuses without it).
# All mutating API calls must then send header  X-Admin-Token: <value>
# Generate one with:  openssl rand -hex 24
LUNELLE_ADMIN_TOKEN=

# --- Storage (all created automatically on init) ---
# Base data directory; the defaults below derive from it if unset.
LUNELLE_DATA_DIR=./data
# LUNELLE_DB_PATH=./data/lunelle.db
# LUNELLE_OUTPUT_DIR=./data/outputs
# LUNELLE_UPLOAD_DIR=./data/uploads
# LUNELLE_EXPORT_DIR=./data/exports
# LUNELLE_LOG_DIR=./data/logs

# --- Image generation provider (REQUIRED for real generation) ---
# Any OpenAI-compatible images endpoint works, e.g.:
#   https://api.openai.com/v1          (model: gpt-image-1)
#   https://ai.wisech.com/v1           (model: doubao-seedream-4-5-251128)
LUNELLE_IMAGE_API_BASE_URL=https://ai.wisech.com/v1
LUNELLE_IMAGE_API_KEY=sk-your-key-here
LUNELLE_IMAGE_MODEL=doubao-seedream-4-5-251128
# openai-compat (production) | mock (tests only; refused in production)
LUNELLE_IMAGE_PROVIDER=openai-compat
# Output sizes (WxH). Grid must be square (1:1).
LUNELLE_GRID_IMAGE_SIZE=2048x2048
LUNELLE_WEARING_IMAGE_SIZE=2048x2048
# How the grid image is passed as the design reference for the wearing shot:
#   auto        - pick based on provider/model (recommended)
#   seedream    - JSON "image" parameter on /images/generations
#   openai-edits- multipart /images/edits
#   off         - text-only wearing prompt (weaker style consistency)
LUNELLE_REFERENCE_MODE=auto

# --- Optional text model for natural-language style parsing ---
# If unset, a deterministic keyword parser is used (no API cost).
# Defaults to the image API base URL/key when only the model is set.
LUNELLE_TEXT_API_BASE_URL=
LUNELLE_TEXT_API_KEY=
LUNELLE_TEXT_MODEL=

# --- Task execution ---
# Max image generation requests in flight at once.
LUNELLE_MAX_CONCURRENCY=2
# Automatic retries per task for retryable errors (timeouts, 429, 5xx).
LUNELLE_MAX_RETRIES=2
# Base seconds for exponential retry backoff (base * 2^n).
LUNELLE_RETRY_BACKOFF_BASE_S=15
# Hard timeout for one provider request, seconds.
LUNELLE_REQUEST_TIMEOUT_S=300

# --- Validation / QA ---
# Minimum acceptable image side length in pixels.
LUNELLE_QA_MIN_SIDE=1024
# Max upload size for reference images, MB.
LUNELLE_MAX_UPLOAD_MB=10

# --- Cost accounting (USD per image, JSON map; optional override) ---
# LUNELLE_PRICING_JSON={"doubao-seedream-4-5-251128": 0.04, "gpt-image-1": 0.17}

# --- Cost controls ---
# Shared allowance for AUTOMATIC work per root task: re-generations and
# corrections draw from ONE budget, so they cannot alternate and reset each
# other's limit (which is what made the quoted worst case not a real bound).
# LUNELLE_AUTO_REGEN_MAX remains the on/off switch; this decides how much.
LUNELLE_MAX_LINEAGE_DESCENDANTS=2
# Rolling 24h spend cap in USD. The breaker is checked when queueing AND again
# in the worker immediately before each provider call, so a batch authorized
# earlier cannot spend money the budget no longer allows. Tripping costs zero
# (the task fails as budget_exceeded before any request is made) and recovers
# via manual retry once the window rolls. 0 disables it; REQUIRED in production.
# Default 20 = roughly 400 seedream images or 40 full try-on matrices.
LUNELLE_DAILY_BUDGET_USD=20
# Batches whose WORST CASE reaches this must be authorized by echoing that
# ceiling back (POST /matrix/estimate, then confirm_max_usd). Gating on the
# ceiling rather than the expected cost is deliberate: approving $0.64 while
# exposed to $3.84 is not consent. A full 16-cell matrix's ceiling is ~3.84 at
# seedream prices with the defaults below. 0 disables the prompt entirely.
LUNELLE_CONFIRM_COST_USD=1.00

# --- Outbound request safety (SSRF) ---
# API profiles are operator-editable and the server makes requests to them, so
# hostnames resolving to loopback/private/link-local space are refused by
# default — that includes cloud metadata (169.254.169.254). Set to 1 ONLY for a
# deliberately self-hosted model on a trusted network; refused in production.
# https is always required regardless of this setting.
LUNELLE_ALLOW_PRIVATE_API_HOSTS=0

# Seedream (Volcano Ark) adds an "AI generated" watermark by default; 1 (default)
# asks the provider to omit it. Check your local rules on AI-content labeling.
LUNELLE_DISABLE_PROVIDER_WATERMARK=1

# --- Hero listing shot (contract-locked, added 2026-07-26) ---
# Landscape Shopify hero size; generated via output_type=hero.
# LUNELLE_HERO_IMAGE_SIZE=1536x1024
